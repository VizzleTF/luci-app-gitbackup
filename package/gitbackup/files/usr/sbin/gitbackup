#!/bin/sh
# shellcheck shell=sh
#
# gitbackup -- CLI entry point and exit-code contract.
#
# Exit codes, shared with every module: 0 ok, 1 general error, 2 invalid
# configuration, 3 network or authentication, 4 refused for safety.
#
# GB_SHARE and GB_STATE_DIR are overridable only so tests/run.sh can point
# this script at a tree that is not /usr/share/gitbackup and a state
# directory that is not /var/run/gitbackup; the router never sets either.

set -u

GB_SHARE="${GB_SHARE:-/usr/share/gitbackup}"
GB_STATE_DIR="${GB_STATE_DIR:-/var/run/gitbackup}"

# shellcheck disable=SC1091  # GB_SHARE is a runtime path, not resolvable statically
. "$GB_SHARE/lib.sh"
# shellcheck disable=SC1091
. "$GB_SHARE/device.sh"
# shellcheck disable=SC1091
. "$GB_SHARE/remoteurl.sh"
# shellcheck disable=SC1091
. "$GB_SHARE/visibility.sh"
# shellcheck disable=SC1091
. "$GB_SHARE/auth.sh"
# shellcheck disable=SC1091
. "$GB_SHARE/collect.sh"
# shellcheck disable=SC1091
. "$GB_SHARE/scrub.sh"
# shellcheck disable=SC1091
. "$GB_SHARE/gitio.sh"
# card.sh does not exist yet (ticket 09, bootstrap): cmd_run's own RECOVERY.md
# step below checks for gb_card with `command -v` before calling it rather
# than sourcing a file that is not there yet -- "ничего не устанавливать
# молча" cuts both ways, this does not invent card.sh's API in the meantime
# either.
if [ -r "$GB_SHARE/card.sh" ]; then
	# shellcheck disable=SC1091
	. "$GB_SHARE/card.sh"
fi

usage() {
	cat <<'EOF'
Usage: gitbackup <command> [options]

Commands:
  run        run a backup now
  status     print current status as JSON
  collect    build a backup set and manifest without pushing
  diff       show what changed since the last successful run
  keygen     generate the SSH deploy key
  pubkey     print the deploy key's public key
  test       verify connectivity and remote configuration
  paths      list the effective sysupgrade paths
  restore    restore configuration from a commit
  card       print a recovery card
  log        show recent gitbackup log entries
EOF
}

# gb_cron_looks_valid <expr>
#
# A minimal structural check -- not the validator schedule.sh will own once
# it exists (ticket 06), just enough to keep config validation honest today.
# busybox crond has no @-macros at all (CONFIG_FEATURE_CROND_SPECIAL_TIMES=n,
# measured on the 25.12.4 stand) and silently drops any crontab line shorter
# than six fields, so a config this obviously broken is worth exit 2 now
# rather than a cron job that never fires and never says why.
gb_cron_looks_valid() {
	# shellcheck disable=SC2086  # word-splitting is the point: counting the expression's fields
	set -- $1
	[ "$#" -eq 5 ] || return 1
	case "$1" in '@'*) return 1 ;; esac
	return 0
}

# gb_validate_config -- resolves the device name and enforces the config rules
# from the spec, dying with exit 2 on the first one that fails. For subcommands
# that actually act on the remote -- run, test, restore, and every other
# not-implemented-yet stub in this ticket -- an unusable config is worth
# refusing before anything starts. status does NOT call this (see
# gb_status_config): a freshly installed router's default config is not an
# error a read-only status check gets to refuse, only something it has to
# report honestly. Sets GB_DEVICE, GB_URL and GB_SCRUB for callers.
gb_validate_config() {
	GB_DEVICE=$(gb_device_id) || exit $?

	_gb_sched=$(gb_uci_get gitbackup.main.schedule daily)
	if [ "$_gb_sched" = cron ]; then
		_gb_cron=$(gb_uci_get gitbackup.main.cron_expr)
		gb_cron_looks_valid "$_gb_cron" ||
			gb_die 2 "gitbackup.main.cron_expr: '$_gb_cron' is not a 5-field cron expression busybox crond can run (no @macros)"
	fi

	GB_URL=$(gb_uci_get gitbackup.origin.url)
	[ -n "$GB_URL" ] || gb_die 2 'gitbackup.origin.url: empty, a repository url is required'

	GB_SCRUB=$(_gb_effective_scrub)
}

# _gb_effective_scrub -- R99: a public remote is scrubbed whether the user
# remembered to say so or not. This overrides only the in-memory decision for
# this run/status call, not the user's saved gitbackup.security.scrub --
# silently rewriting their config is its own kind of surprise. Shared by the
# strict and the lenient validator so the two never disagree about it.
_gb_effective_scrub() {
	_gb_vis=$(gb_uci_get gitbackup.origin.visibility private)
	_gb_scrub=$(gb_uci_get gitbackup.security.scrub 0)
	if [ "$_gb_vis" = public ] && [ "$(gb_json_bool "$_gb_scrub")" != true ]; then
		gb_log notice 'gitbackup.origin.visibility=public forces security.scrub on for this run'
		_gb_scrub=1
	fi
	printf '%s\n' "$_gb_scrub"
}

# gb_status_config -- the same fields gb_validate_config resolves, but never
# exits. A field that would make the strict validator die instead lands in
# GB_MISSING (a space-separated list of option names) and GB_CONFIGURED is set
# to false; `gitbackup status` on the acceptance criterion's fresh-install
# config (device_id=hostname, hostname 'OpenWrt', empty url) must print valid
# JSON, not exit 2. Sets GB_DEVICE (possibly empty), GB_URL, GB_SCRUB,
# GB_CONFIGURED and GB_MISSING.
gb_status_config() {
	GB_MISSING=''

	# gb_device_id dies (exit 2) inside this command substitution's own
	# subshell on any of its three failure modes; the subshell's exit status
	# lands in $?, and the die's own log line is discarded here rather than
	# reported twice.
	if ! GB_DEVICE=$(gb_device_id 2>/dev/null); then
		GB_DEVICE=''
		GB_MISSING="$GB_MISSING device_id"
	fi

	_gb_sched=$(gb_uci_get gitbackup.main.schedule daily)
	if [ "$_gb_sched" = cron ]; then
		_gb_cron=$(gb_uci_get gitbackup.main.cron_expr)
		gb_cron_looks_valid "$_gb_cron" || GB_MISSING="$GB_MISSING cron_expr"
	fi

	GB_URL=$(gb_uci_get gitbackup.origin.url)
	[ -n "$GB_URL" ] || GB_MISSING="$GB_MISSING url"

	GB_SCRUB=$(_gb_effective_scrub)

	if [ -n "$GB_MISSING" ]; then
		GB_CONFIGURED=false
	else
		GB_CONFIGURED=true
	fi
}

cmd_status() {
	_gb_enabled=$(gb_uci_get gitbackup.main.enabled 0)
	_gb_token_file=$(gb_uci_get gitbackup.origin.token_file /etc/gitbackup/token)
	_gb_token_set=false
	[ -s "$_gb_token_file" ] && _gb_token_set=true

	_gb_last_run='null'
	[ -f "$GB_STATE_DIR/last_run" ] && _gb_last_run=$(cat "$GB_STATE_DIR/last_run")

	printf '{\n'
	printf '  "enabled": %s,\n' "$(gb_json_bool "$_gb_enabled")"
	printf '  "configured": %s,\n' "$GB_CONFIGURED"
	printf '  "device": %s,\n' "$(gb_json_str "$GB_DEVICE")"
	printf '  "scrub": %s,\n' "$(gb_json_bool "$GB_SCRUB")"
	printf '  "token_set": %s,\n' "$_gb_token_set"
	printf '  "last_run": %s,\n' "$_gb_last_run"
	printf '  "missing": ['
	_gb_first=1
	for _gb_m in $GB_MISSING; do
		[ "$_gb_first" -eq 1 ] || printf ','
		printf '%s' "$(gb_json_str "$_gb_m")"
		_gb_first=0
	done
	printf ']\n'
	printf '}\n'
}

# cmd_test -- `gitbackup test` (ticket 04, spec "Аутентификация" +
# "Гейт видимости"). Reaches the remote end to end and tells the operator
# exactly which of the three ways that can fail actually happened, rather
# than one generic error:
#
#   exit 3  network unreachable, or the remote rejected the credentials
#   exit 4  the repository is publicly visible -- push refused outright
#
# Both network-unreachable and auth-rejected land on exit 3: the shared
# exit-code contract (interfaces.md, "Коды выхода") has exactly one slot for
# "network or auth", by design -- what tells the two apart for the operator
# is the message this prints and logs, not the exit code.
#
# Deliberately does NOT call lib.sh's gb_have_net as a pre-check (an earlier
# version of this function did): measured live on the owlab 25.12.4 stand,
# this image's busybox nc applet does not implement `-w` at all --
# `nc -w 5 host port` prints nc's usage banner and exits 1 for every host,
# reachable or not, which made gb_have_net report every remote as
# unreachable including a real, working connection to github.com. git's own
# error text already distinguishes "could not connect" from "connected but
# rejected" without needing a second, less reliable tool to ask first (see
# _gb_test_classify below) -- confirmed against real output from this same
# stand for both the https and ssh transports.
cmd_test() {
	_gb_parsed=$(gb_parse_url "$GB_URL") ||
		gb_die 2 "gitbackup.origin.url: '$GB_URL' does not match any supported remote URL form"
	# shellcheck disable=SC2086  # word-splitting is the point: five fields from one line
	set -- $_gb_parsed
	_gb_scheme="$1"
	_gb_host="$2"
	_gb_port="$3"

	# The visibility gate first: a repository confirmed public is refused
	# before this ever dials the remote for real, and "could not tell" (exit
	# 3, spec "Гейт видимости": "3 означает проверить не удалось, а не
	# можно") is branched on separately from "confirmed not public" (0) --
	# never folded into "proceed".
	gb_visibility_ok "$GB_URL"
	case $? in
		4) gb_die 4 "$GB_URL is publicly visible to an anonymous request; push refused" ;;
		3) gb_die 3 "could not verify whether $GB_URL is public (network or provider API unreachable); try again once connectivity is confirmed" ;;
	esac

	# Host key acceptance only happens here, never in `run` (spec:
	# "Host key принимается только внутри gitbackup test"). Safe to call on
	# every `test` run: gb_accept_hostkey itself is a no-op (return 0) once
	# the key is already trusted. Its own ssh call is what actually dials
	# the network for an ssh:// remote -- a host that cannot be reached at
	# all is caught right here (rc 2) rather than falling through to
	# git ls-remote below.
	if [ "$_gb_scheme" = ssh ]; then
		_gb_hk_port="$_gb_port"
		[ "$_gb_hk_port" != 0 ] || _gb_hk_port=22
		gb_accept_hostkey "$_gb_host" "$_gb_hk_port"
		case $? in
			0) ;;
			1) gb_die 3 "$_gb_host:$_gb_hk_port host key was not accepted" ;;
			*) gb_die 3 "$_gb_host:$_gb_hk_port host key could not be obtained -- is the network reachable?" ;;
		esac
	fi

	# eval, not process substitution (a bashism this CLI cannot use,
	# interfaces.md: POSIX sh for busybox ash) -- gb_git_env's own quoting
	# is what makes this eval safe.
	eval "$(gb_git_env)"
	if _gb_err=$(git ls-remote "$GB_URL" 2>&1 >/dev/null); then
		gb_log notice "gitbackup test: $GB_URL is reachable and authenticated"
		printf 'ok: %s is reachable and authenticated\n' "$GB_URL"
		return 0
	fi

	_gb_test_classify "$_gb_host" "$_gb_err"
}

# _gb_test_classify <host> <git-stderr> -- the message-only half of the
# network/auth split: both exit 3 (see cmd_test's own header comment), but
# the operator still needs to know which one happened. Matched against
# git's own wording for a connection that never got made at all --
# confirmed live on the owlab stand: `git ls-remote https://127.0.0.1:1/...`
# gives "Failed to connect to 127.0.0.1 port 1 ...: Error", and
# `git ls-remote ssh://git@127.0.0.1:2/...` gives
# "ssh: connect to host 127.0.0.1 port 2: Connection refused" -- both
# wrapped in git's own "fatal: unable to access"/"Could not read from
# remote repository". Anything else (measured: "Permission denied
# (publickey)" for a real host with the wrong key) is authentication, not
# network.
_gb_test_classify() {
	_gb_h="$1"
	_gb_e="$2"
	case "$_gb_e" in
		*'Could not resolve host'*|*'Failed to connect'*|*'Connection timed out'*| \
		*'Connection refused'*|*'Network is unreachable'*|*'ssh: connect to host'*|*'No route to host'*)
			gb_die 3 "cannot reach $_gb_h: $_gb_e"
			;;
		*)
			gb_die 3 "authentication to $GB_URL failed: $_gb_e"
			;;
	esac
}

# ---------------------------------------------------------------------------
# run (ticket 07, spec "Как коммит попадает в репозиторий без клона")
# ---------------------------------------------------------------------------
#
# The 15-step algorithm split across two functions: cmd_run does steps 1-6
# (flock, the network precheck, the /tmp working directory and its trap,
# the space check, the visibility gate) -- everything that needs GB_URL in
# its real, schema-valid form (gb_parse_url, gb_visibility_ok both die on
# anything else) and that ends in "skipped, exit 0" far more often than it
# reaches git at all. _gb_run_backup does steps 7-15 (collect, compare,
# build, commit, push, state) and reads GB_URL only as an opaque string
# handed straight to `git` -- it never re-parses it -- which is what makes
# it callable on its own, against a real local bare repository, for
# gitio.sh's own tests (interfaces.md: gitio.sh is the one module tested
# against a real repo, not stubs).

# _gb_run_estimate_kb -- the size, in kilobytes, of everything
# `sysupgrade -l` would collect, read directly off the filesystem with no
# copy yet (spec step 5 has to run BEFORE gb_collect ever touches /tmp).
# Symlinks are skipped (their own size is a few bytes and does not matter
# to a x2-plus-headroom estimate); a path sysupgrade -l names that is no
# longer there simply contributes 0, same as gb_collect's own tolerance
# for that case.
_gb_run_estimate_kb() {
	sysupgrade -l 2>/dev/null | while IFS= read -r _gb_p || [ -n "$_gb_p" ]; do
		[ -n "$_gb_p" ] || continue
		[ -f "$_gb_p" ] || continue
		wc -c <"$_gb_p" 2>/dev/null
	done | awk '{s += $1} END {printf "%d", (s + 1023) / 1024}'
}

# _gb_run_join_comma -- reads lines on stdin, prints them comma-and-space
# joined on one line, empty input producing empty output. Used for both the
# subject's short device-config list and the body's full path list.
_gb_run_join_comma() {
	_gb_rjc_first=1
	while IFS= read -r _gb_rjc_l || [ -n "$_gb_rjc_l" ]; do
		[ -n "$_gb_rjc_l" ] || continue
		if [ "$_gb_rjc_first" -eq 1 ]; then _gb_rjc_first=0; else printf ', '; fi
		printf '%s' "$_gb_rjc_l"
	done
}

# _gb_run_changed_configs <old-manifest-or-missing> <new-manifest>
#
# Prints the basenames (one per line, sorted, deduped) of every
# /etc/config/* path whose manifest entry line differs between the two
# files -- added, removed, or changed in any field (content OR mode/uid/
# gid, so a chmod-only edit still shows up here, same as it already does
# in gb_manifest_equal's own broader "did anything change" verdict). No
# comm(1) (confirmed absent from the 25.12.4 image) and no diff(1)
# dependency: concatenating both files' matching lines and keeping only the
# ones sort+uniq -u find exactly once is the same "differs between the two
# sets" test using only applets already in DEPENDS.
_gb_run_changed_configs() {
	_gb_rcc_old="$1"
	_gb_rcc_new="$2"
	{
		[ -r "$_gb_rcc_old" ] && grep '"path":"/etc/config/' "$_gb_rcc_old"
		grep '"path":"/etc/config/' "$_gb_rcc_new"
	} 2>/dev/null | sort | uniq -u | sed -n 's#.*"path":"/etc/config/\([^"]*\)".*#\1#p' | sort -u
}

# _gb_run_write_message <msgfile> <trigger> <changed-list> <changed-count>
#
# Spec "Формат коммита": subject starts with the backup's own UTC date and
# time (G03: readable straight out of a commit list on the web, no need to
# open the commit), then the short device name, then up to three changed
# config names -- "and N more" past that. Body: Changed (full
# /etc/config/* paths), Trigger (this run's --trigger), OpenWrt (release +
# revision straight out of /etc/openwrt_release, parsed with parameter
# expansion rather than a quoting-fragile sed regex -- the file's own
# `KEY='value'` shape needs nothing more), Device.
_gb_run_write_message() {
	_gb_rwm_file="$1"
	_gb_rwm_trigger="$2"
	_gb_rwm_list="$3"
	_gb_rwm_count="$4"

	_gb_rwm_when=$(date -u +'%Y-%m-%d %H:%M')

	_gb_rwm_short=$(printf '%s\n' "$_gb_rwm_list" | sed -n '1,3p' | _gb_run_join_comma)
	[ -n "$_gb_rwm_short" ] || _gb_rwm_short='config'
	if [ "$_gb_rwm_count" -gt 3 ]; then
		_gb_rwm_short="$_gb_rwm_short and $((_gb_rwm_count - 3)) more"
	fi

	_gb_rwm_paths=$(printf '%s\n' "$_gb_rwm_list" | sed -n '/./ s#^#/etc/config/#p' | _gb_run_join_comma)
	[ -n "$_gb_rwm_paths" ] || _gb_rwm_paths='(no /etc/config/* entry changed)'

	_gb_rwm_release=''
	_gb_rwm_revision=''
	_gb_rwm_relfile="${GB_ROOT:-}/etc/openwrt_release"
	if [ -r "$_gb_rwm_relfile" ]; then
		while IFS='=' read -r _gb_rwm_k _gb_rwm_v || [ -n "$_gb_rwm_k" ]; do
			_gb_rwm_v="${_gb_rwm_v#\'}"
			_gb_rwm_v="${_gb_rwm_v%\'}"
			case "$_gb_rwm_k" in
				DISTRIB_RELEASE) _gb_rwm_release="$_gb_rwm_v" ;;
				DISTRIB_REVISION) _gb_rwm_revision="$_gb_rwm_v" ;;
			esac
		done <"$_gb_rwm_relfile"
	fi

	{
		printf '%s %s: %s\n' "$_gb_rwm_when" "$GB_DEVICE" "$_gb_rwm_short"
		printf '\n'
		printf 'Changed: %s\n' "$_gb_rwm_paths"
		printf 'Trigger: %s\n' "$_gb_rwm_trigger"
		printf 'OpenWrt: %s %s\n' "$_gb_rwm_release" "$_gb_rwm_revision"
		printf 'Device: %s\n' "$GB_DEVICE"
	} >"$_gb_rwm_file"
}

# _gb_run_write_state <result> <reason> <commit-or-empty> [<timings-json>]
#
# Two files, spec step 15: GB_STATE_DIR/last_run is the one cmd_status
# already reads back verbatim as its own "last_run" JSON field (ticket 01)
# -- just a quoted timestamp string, nothing richer. GB_STATE_DIR/state.json
# is the fuller record the spec itself asks for (result, reason, branch,
# commit, per-stage timings) for a future status/overview screen; both are
# tmpfs (git is the source of truth, spec: "Состояние в
# /var/run/gitbackup/state.json (tmpfs); git -- источник истины") and
# neither is ever read back by this CLI itself.
_gb_run_write_state() {
	_gb_rws_result="$1"
	_gb_rws_reason="$2"
	_gb_rws_commit="${3:-}"
	_gb_rws_timings="${4:-{\"collect_s\":0,\"compare_s\":0,\"push_s\":0}}"

	mkdir -p "$GB_STATE_DIR" 2>/dev/null
	_gb_rws_now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	printf '%s\n' "$(gb_json_str "$_gb_rws_now")" >"$GB_STATE_DIR/last_run" 2>/dev/null
	{
		printf '{\n'
		printf '  "generated": %s,\n' "$(gb_json_str "$_gb_rws_now")"
		printf '  "result": %s,\n' "$(gb_json_str "$_gb_rws_result")"
		printf '  "reason": %s,\n' "$(gb_json_str "$_gb_rws_reason")"
		printf '  "branch": %s,\n' "$(gb_json_str "${_gb_branch:-}")"
		printf '  "commit": %s,\n' "$(gb_json_str "$_gb_rws_commit")"
		printf '  "timings": %s\n' "$_gb_rws_timings"
		printf '}\n'
	} >"$GB_STATE_DIR/state.json" 2>/dev/null
}

# _gb_run_backup <trigger> -- spec steps 7-15, see this section's own
# header comment for why this is split out of cmd_run.
_gb_run_backup() {
	_gb_trigger="$1"

	_gb_branch=$(gb_expand "$(gb_uci_get gitbackup.origin.branch 'device/{device}')")
	_gb_prefix=$(gb_expand "$(gb_uci_get gitbackup.main.path_prefix 'devices/{device}')")
	# shellcheck disable=SC2034  # read by gb_build_tree (gitio.sh) as an environment seam, not used in this file
	GB_PREFIX="$_gb_prefix"

	_gb_outdir="$WORK/tree"
	_gb_repodir="$WORK/repo"
	# gb_fetch_meta (gitio.sh) also does this, but only runs at all when a
	# parent already exists -- a brand-new branch's first-ever backup has
	# no parent to fetch, and gb_build_tree/gb_commit_push both still need
	# a real .git here to run their own plumbing against.
	[ -d "$_gb_repodir/.git" ] || git init -q "$_gb_repodir" ||
		gb_die 1 "gitbackup run: git init $_gb_repodir failed"

	# Step 7: collect, then scrub in place if this run's effective
	# visibility=public forced it on (usr/sbin/gitbackup's own
	# _gb_effective_scrub already resolved GB_SCRUB once, before cmd_run).
	_gb_t_collect_start=$(date +%s)
	gb_collect "$_gb_outdir" || gb_die 1 'gitbackup run: gb_collect failed'
	if [ "$(gb_json_bool "$GB_SCRUB")" = true ]; then
		gb_scrub "$_gb_outdir" 2>/dev/null | while IFS= read -r _gb_sl || [ -n "$_gb_sl" ]; do
			[ -n "$_gb_sl" ] && gb_log info "gitbackup run: scrubbed $_gb_sl"
		done
	fi
	_gb_t_collect_end=$(date +%s)

	# Steps 8-10: who is the parent, what did it look like, did anything
	# actually change. GB_PARENT (environment) is gitio.sh's own seam for
	# gb_build_tree, not a positional argument -- see gitio.sh's header.
	_gb_t_compare_start=$(date +%s)
	GB_PARENT=$(gb_remote_head "$_gb_branch")
	_gb_head_rc=$?
	[ "$_gb_head_rc" -eq 0 ] || gb_die 3 "gitbackup run: could not reach $GB_URL to resolve $_gb_branch"

	_gb_old_manifest="$WORK/old_manifest.json"
	_gb_changed=1
	if [ -n "$GB_PARENT" ]; then
		gb_fetch_meta "$_gb_branch" "$_gb_repodir" ||
			gb_die 3 "gitbackup run: could not fetch $_gb_branch metadata from $GB_URL"
		if git --git-dir="$_gb_repodir/.git" cat-file -p "$GB_PARENT:$_gb_prefix/manifest.json" \
			>"$_gb_old_manifest" 2>/dev/null; then
			if gb_manifest_equal "$_gb_old_manifest" "$(gb_manifest_path "$_gb_outdir")"; then
				_gb_changed=0
			fi
		fi
	fi
	_gb_t_compare_end=$(date +%s)
	_gb_t_collect_s=$((_gb_t_collect_end - _gb_t_collect_start))
	_gb_t_compare_s=$((_gb_t_compare_end - _gb_t_compare_start))

	if [ "$_gb_changed" -eq 0 ]; then
		gb_log notice "gitbackup run: no changes since the last backup on $_gb_branch"
		printf 'no changes\n'
		_gb_run_write_state ok no-changes "$GB_PARENT" \
			"{\"collect_s\":$_gb_t_collect_s,\"compare_s\":$_gb_t_compare_s,\"push_s\":0}"
		gb_log notice "gitbackup run: timings -- collect ${_gb_t_collect_s}s, compare ${_gb_t_compare_s}s, push 0s"
		exit 0
	fi

	# 11a: the archive, only now that there is definitely something to
	# push (spec: sysupgrade -b's own gzip is not deterministic byte for
	# byte, so building it before the compare above would commit a diff
	# every single run even when nothing on the router changed).
	if [ "$(gb_json_bool "$(gb_uci_get gitbackup.main.archive 1)")" = true ]; then
		sysupgrade -b "$_gb_outdir/backup.tar.gz" >/dev/null 2>&1 ||
			gb_log warning 'gitbackup run: sysupgrade -b failed, continuing without backup.tar.gz'
	fi

	# 11b: the recovery card -- only once card.sh (ticket 09) exists; see
	# this file's own sourcing block for why it is optional today.
	if command -v gb_card >/dev/null 2>&1; then
		gb_card "$_gb_outdir/RECOVERY.md" 2>/dev/null
	fi

	_gb_changed_list=$(_gb_run_changed_configs "$_gb_old_manifest" "$(gb_manifest_path "$_gb_outdir")")
	_gb_changed_count=$(printf '%s\n' "$_gb_changed_list" | grep -c .)
	_gb_msgfile="$WORK/commit-message"
	_gb_run_write_message "$_gb_msgfile" "$_gb_trigger" "$_gb_changed_list" "$_gb_changed_count"

	# Steps 11/12/13/14: build the tree, commit, push, retry once on a
	# non-fast-forward (spec step 14) by re-resolving the parent and
	# rebuilding the tree on top of it -- gb_build_tree's own GB_PARENT
	# seam means this collected backup set ($_gb_outdir, untouched since
	# step 7) does not need to be re-collected for the retry, only the git
	# plumbing around it does.
	_gb_t_push_start=$(date +%s)
	_gb_attempt=1
	while :; do
		_gb_tree=$(gb_build_tree "$_gb_repodir" "$_gb_outdir")
		[ -n "$_gb_tree" ] || gb_die 1 'gitbackup run: gb_build_tree failed'

		_gb_commit=$(gb_commit_push "$_gb_repodir" "$_gb_tree" "$GB_PARENT" "$_gb_msgfile" "$_gb_branch")
		_gb_push_rc=$?
		case "$_gb_push_rc" in
			0) break ;;
			2)
				if [ "$_gb_attempt" -ge 2 ]; then
					gb_die 1 "gitbackup run: $_gb_branch changed again during the retry, giving up (spec step 14: one retry only)"
				fi
				gb_log notice "gitbackup run: $_gb_branch moved under us, retrying once"
				_gb_attempt=2
				GB_PARENT=$(gb_remote_head "$_gb_branch")
				_gb_head_rc=$?
				[ "$_gb_head_rc" -eq 0 ] || gb_die 3 "gitbackup run: could not re-resolve $_gb_branch for the retry"
				gb_fetch_meta "$_gb_branch" "$_gb_repodir" ||
					gb_die 3 "gitbackup run: could not re-fetch $_gb_branch metadata for the retry"
				;;
			1) gb_die 1 'gitbackup run: gb_commit_push could not build the commit, see log' ;;
			*) gb_die 3 'gitbackup run: push failed, see log' ;;
		esac
	done
	_gb_t_push_end=$(date +%s)
	_gb_t_push_s=$((_gb_t_push_end - _gb_t_push_start))

	gb_log notice "gitbackup run: pushed $_gb_commit to $_gb_branch"
	printf 'pushed %s to %s\n' "$_gb_commit" "$_gb_branch"
	_gb_run_write_state ok pushed "$_gb_commit" \
		"{\"collect_s\":$_gb_t_collect_s,\"compare_s\":$_gb_t_compare_s,\"push_s\":$_gb_t_push_s}"
	gb_log notice "gitbackup run: timings -- collect ${_gb_t_collect_s}s, compare ${_gb_t_compare_s}s, push ${_gb_t_push_s}s"
}

# cmd_run [--trigger cron|manual|procd|luci] -- spec steps 1-6, then hands
# off to _gb_run_backup for the rest. The default trigger, "cron", is what
# schedule.sh's own crontab line actually invokes (`gitbackup run` with no
# flag at all, ticket 06) -- an explicit --trigger is how the other three
# callers (a human at the CLI, procd's config_change, the LuCI rpcd bridge)
# say which one they are.
cmd_run() {
	_gb_trigger=cron
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--trigger)
				shift
				[ "$#" -gt 0 ] && { _gb_trigger="$1"; shift; }
				;;
			--trigger=*) _gb_trigger="${1#--trigger=}"; shift ;;
			*) shift ;;
		esac
	done

	# Step 1: flock, non-blocking. Busybox flock's FD form (`flock -n 9`
	# against an fd opened by this same shell's own `exec`) -- confirmed on
	# the owlab stand's busybox 1.37.0 (`flock [-sxun] FD | { FILE ... }`).
	# Locked -> skipped, exit 0: cron must not mail about an overlap that
	# resolved itself (brief, verbatim: "flock /var/run/gitbackup.lock,
	# занято -> выход 0, skipped").
	_gb_lockfile="${GB_LOCK_FILE:-/var/run/gitbackup.lock}"
	mkdir -p "$(dirname "$_gb_lockfile")" 2>/dev/null
	exec 9>"$_gb_lockfile" || gb_die 1 "gitbackup run: cannot open lock file $_gb_lockfile"
	if ! flock -n 9; then
		gb_log notice 'gitbackup run: another run already holds the lock, skipped'
		printf 'skipped: another run is already in progress\n'
		exit 0
	fi

	# Step 3: a bounded reachability probe before anything else touches
	# disk. gb_have_net (lib.sh, D01) is the fixed implementation.
	_gb_parsed=$(gb_parse_url "$GB_URL") ||
		gb_die 2 "gitbackup.origin.url: '$GB_URL' does not match any supported remote URL form"
	# shellcheck disable=SC2086  # word-splitting is the point: five fields from one line
	set -- $_gb_parsed
	_gb_scheme="$1"
	_gb_host="$2"
	_gb_port="$3"
	_gb_netport="$_gb_port"
	if [ "$_gb_netport" = 0 ]; then
		if [ "$_gb_scheme" = ssh ]; then _gb_netport=22; else _gb_netport=443; fi
	fi
	if ! gb_have_net "$_gb_host" "$_gb_netport"; then
		gb_log notice "gitbackup run: $_gb_host:$_gb_netport unreachable, skipped"
		printf 'skipped: %s is unreachable\n' "$_gb_host"
		exit 0
	fi

	# Step 4: everything from here on lives under /tmp -- never flash,
	# never USB ("качать репозиторий на роутер вообще нельзя") -- and is
	# gone the moment this process ends: $WORK holds a full plaintext
	# backup set and, briefly, credentials.
	WORK=$(mktemp -d "${TMPDIR:-/tmp}/gitbackup.XXXXXX") ||
		gb_die 1 'gitbackup run: cannot create a working directory under /tmp'
	trap 'rm -rf "$WORK"' EXIT INT TERM

	# Step 5: space, checked before anything is actually collected.
	_gb_set_kb=$(_gb_run_estimate_kb)
	_gb_need_kb=$((_gb_set_kb * 2 + 1024))
	# The same directory $WORK was just created under, not a hardcoded
	# "/tmp": they must agree, or a TMPDIR override (tests/run.sh's own
	# seam, since /tmp itself is shared and not size-controllable in a
	# unit test) would check one filesystem while actually writing to
	# another.
	_gb_free_kb=$(gb_free_kb "${TMPDIR:-/tmp}")
	case "$_gb_free_kb" in '' | *[!0-9]*) _gb_free_kb=0 ;; esac
	if [ "$_gb_free_kb" -lt "$_gb_need_kb" ]; then
		gb_die 1 "gitbackup run: not enough space in /tmp -- need ~${_gb_need_kb} KB (backup set ~${_gb_set_kb} KB x2 + 1024 KB headroom), have ${_gb_free_kb} KB free; reduce the backup set (e.g. gitbackup.main.archive='0', or trim the sysupgrade path list) or free up /tmp"
	fi

	# Step 6: the visibility gate. Code 3 ("could not verify") is treated
	# exactly like "no network" above -- skipped, not a hard failure, spec
	# "Гейт видимости": "Сеть недоступна или API ответило 5xx -- прогон
	# завершается skipped, а не «считаем приватным»". A confirmed-public
	# repository (4) is the one outcome that is never silent.
	gb_visibility_ok "$GB_URL"
	case $? in
		4) gb_die 4 "$GB_URL is publicly visible to an anonymous request; push refused" ;;
		3)
			gb_log notice "gitbackup run: could not verify whether $GB_URL is public, skipped"
			printf 'skipped: could not verify repository visibility\n'
			exit 0
			;;
	esac

	eval "$(gb_git_env)"

	_gb_run_backup "$_gb_trigger"
}

# cmd_log [lines] -- A01: syslog is the log (lib.sh's own gb_log header
# comment -- logread survives a reboot, a plain variable does not), so
# `gitbackup log` is a thin, tag-filtered read of it. run's own gb_log
# calls above (collect/compare/push timings, skip/refuse reasons, retry
# notices) are what actually show up here; this command adds no format of
# its own to keep in sync with them.
cmd_log() {
	_gb_lines="${1:-50}"
	case "$_gb_lines" in '' | *[!0-9]*) _gb_lines=50 ;; esac
	logread -e gitbackup 2>/dev/null | tail -n "$_gb_lines"
}

[ "$#" -ge 1 ] || { usage; exit 0; }

cmd="$1"
shift

case "$cmd" in
	status)
		# Lenient on purpose: see gb_status_config. A fresh install's default
		# config must not turn a read-only status check into exit 2.
		gb_status_config
		cmd_status
		;;
	keygen)
		# No gb_validate_config: generating a deploy key depends only on
		# gitbackup.origin.key_file (which always has a default), never on
		# GB_URL or the device name -- in the real bootstrap order the key
		# is generated and its public half handed to the provider BEFORE a
		# remote url even exists to validate.
		_gb_force=''
		for _gb_a in "$@"; do
			[ "$_gb_a" = '--force' ] && _gb_force=1
		done
		gb_keygen "$_gb_force" || exit 1
		printf 'generated %s\n' "$(gb_uci_get gitbackup.origin.key_file /etc/gitbackup/id_ed25519)"
		;;
	pubkey)
		# Same reasoning as keygen: reading back a key that may already
		# exist needs no remote configuration at all.
		gb_pubkey || exit 1
		;;
	test)
		gb_validate_config
		cmd_test
		;;
	run)
		gb_validate_config
		cmd_run "$@"
		;;
	log)
		# No gb_validate_config: reading the log back is a diagnostic that
		# has to work even on a router whose config is not fully set up yet
		# (same reasoning as status/keygen/pubkey above).
		cmd_log "$@"
		;;
	collect|diff|paths|restore|card)
		gb_validate_config
		# Honest placeholders: exit 1 and say so, rather than a stub that
		# pretends to have run. Each lands in its own ticket.
		gb_die 1 "$cmd: not implemented yet"
		;;
	*)
		usage >&2
		gb_die 1 "unknown command '$cmd'"
		;;
esac
